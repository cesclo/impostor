{
  "extends": "semistandard",
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/public/**/*.js", "impostor/js/**/*.js", "heardle/js/**/*.js"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["**/tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true
      }
    }
  ]
}
